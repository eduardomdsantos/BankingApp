<Window x:Class="Assignment_2_master.FormUser"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Assignment_2_master"
        mc:Ignorable="d"
        Title="FormUser" Height="450" Width="800">
    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="File">
                <MenuItem Header="Login"></MenuItem>
                <MenuItem Header="Logout"></MenuItem>
                <MenuItem Header="Register"></MenuItem>
                <MenuItem Header="Exit"></MenuItem>
            </MenuItem>
            <MenuItem Header="Account">
                <MenuItem Header="New Account"></MenuItem>
                <MenuItem Header="Edit Account"></MenuItem>
                <MenuItem Header="Deposit Funds"></MenuItem>
                <MenuItem Header="Withdraw Funds"></MenuItem>
                <MenuItem Header="Transfer Funds"></MenuItem>
                <MenuItem Header="View Transactions"></MenuItem>
            </MenuItem>
            <MenuItem Header="View Accounts"></MenuItem>
        </Menu>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="16*"/>
                <ColumnDefinition Width="5*"/>
                <ColumnDefinition Width="779*"/>
            </Grid.ColumnDefinitions>
            <Label Content="First Name:" HorizontalAlignment="Left" Margin="10,64,0,0" VerticalAlignment="Top" Grid.ColumnSpan="3"/>
            <Label Content="Surname:" HorizontalAlignment="Left" Margin="10,95,0,0" VerticalAlignment="Top" Grid.ColumnSpan="3"/>
            <Label Content="Email:" HorizontalAlignment="Left" Margin="10,126,0,0" VerticalAlignment="Top" Grid.ColumnSpan="3"/>
            <Label Content="Phone:" HorizontalAlignment="Left" Margin="10,157,0,0" VerticalAlignment="Top" Grid.ColumnSpan="3"/>
            <Label Content="Address Line 1:" HorizontalAlignment="Left" Margin="10,188,0,0" VerticalAlignment="Top" Grid.ColumnSpan="3"/>
            <Label Content="Address Line 2:" HorizontalAlignment="Left" Margin="10,219,0,0" VerticalAlignment="Top" Grid.ColumnSpan="3"/>
            <Label Content="City:" HorizontalAlignment="Left" Margin="10,250,0,0" VerticalAlignment="Top" Grid.ColumnSpan="3"/>
            <Label Content="County:" HorizontalAlignment="Left" Margin="10,281,0,0" VerticalAlignment="Top" Grid.ColumnSpan="3"/>
            <Label Content="Username:" HorizontalAlignment="Left" Margin="324,64,0,0" VerticalAlignment="Top" Grid.Column="2"/>
            <Label Content="Password:" HorizontalAlignment="Left" Margin="324,95,0,0" VerticalAlignment="Top" Grid.Column="2"/>
            <TextBox x:Name="txtFirstname" HorizontalAlignment="Left" Margin="84,68,0,0" TextWrapping="Wrap" Text="TextBlock" VerticalAlignment="Top" RenderTransformOrigin="0.192,0.428" Width="193" Grid.Column="2"/>
            <ComboBox x:Name="cboCounty" HorizontalAlignment="Left" Margin="84,283,0,0" VerticalAlignment="Top" Width="193" Grid.Column="2"/>
            <TextBox x:Name="txtSurname" HorizontalAlignment="Left" Margin="84,99,0,0" TextWrapping="Wrap" Text="TextBlock" VerticalAlignment="Top" RenderTransformOrigin="0.192,0.428" Width="193" Grid.Column="2"/>
            <TextBox x:Name="txtEmail" HorizontalAlignment="Left" Margin="84,130,0,0" TextWrapping="Wrap" Text="TextBlock" VerticalAlignment="Top" RenderTransformOrigin="0.192,0.428" Width="193" Grid.Column="2"/>
            <TextBox x:Name="txtPhone" HorizontalAlignment="Left" Margin="84,161,0,0" TextWrapping="Wrap" Text="TextBlock" VerticalAlignment="Top" RenderTransformOrigin="0.192,0.428" Width="193" Grid.Column="2"/>
            <TextBox x:Name="txtAddress1" HorizontalAlignment="Left" Margin="84,192,0,0" TextWrapping="Wrap" Text="TextBlock" VerticalAlignment="Top" RenderTransformOrigin="0.192,0.428" Width="193" Grid.Column="2"/>
            <TextBox x:Name="txtAddress2" HorizontalAlignment="Left" Margin="84,223,0,0" TextWrapping="Wrap" Text="TextBlock" VerticalAlignment="Top" RenderTransformOrigin="0.192,0.428" Width="193" Grid.Column="2"/>
            <TextBox x:Name="txtCity" HorizontalAlignment="Left" Margin="84,254,0,0" TextWrapping="Wrap" Text="TextBlock" VerticalAlignment="Top" RenderTransformOrigin="0.192,0.428" Width="193" Grid.Column="2"/>
            <TextBox x:Name="txtUsername" HorizontalAlignment="Left" Margin="432,68,0,0" TextWrapping="Wrap" Text="TextBlock" VerticalAlignment="Top" RenderTransformOrigin="0.192,0.428" Width="193" Grid.Column="2"/>
            <TextBox x:Name="txtPassword" HorizontalAlignment="Left" Margin="432,99,0,0" TextWrapping="Wrap" Text="TextBlock" VerticalAlignment="Top" RenderTransformOrigin="0.192,0.428" Width="193" Grid.Column="2"/>
            <Button x:Name="btnAdd" Content="Add" HorizontalAlignment="Left" Margin="659,64,0,0" VerticalAlignment="Top" Width="110" Height="40" Grid.Column="2" Click="btnAdd_Click"/>
            <Button x:Name="btnEdit" Content="Edit" HorizontalAlignment="Left" Margin="659,119,0,0" VerticalAlignment="Top" Width="110" Height="40" Grid.Column="2"/>
            <Button x:Name="btnClose" Content="Close" HorizontalAlignment="Left" Margin="659,229,0,0" VerticalAlignment="Top" Width="110" Height="40" Grid.Column="2"/>
            <Button x:Name="btnCancel" Content="Cancel" HorizontalAlignment="Left" Margin="659,176,0,0" VerticalAlignment="Top" Width="110" Height="40" Grid.Column="2"/>

        </Grid>
    </DockPanel>
</Window>
