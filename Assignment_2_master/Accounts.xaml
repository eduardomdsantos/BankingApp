<Window x:Class="Assignment_2_master.New_Account"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Assignment_2_master"
        mc:Ignorable="d"
        Title="BankApp" Height="450" Width="800">
    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="File">
                <MenuItem Header="Login"></MenuItem>
                <MenuItem Header="Logout"></MenuItem>
                <MenuItem Header="Register"></MenuItem>
                <MenuItem Header="Exit"></MenuItem>
            </MenuItem>
            <MenuItem Header="Account">
                <MenuItem Header="New Account"></MenuItem>
                <MenuItem Header="Edit Account"></MenuItem>
                <MenuItem Header="Deposit Funds"></MenuItem>
                <MenuItem Header="Withdraw Funds"></MenuItem>
                <MenuItem Header="Transfer Funds"></MenuItem>
                <MenuItem Header="View Transactions"></MenuItem>
            </MenuItem>
            <MenuItem Header="View Accounts"></MenuItem>
        </Menu>
        <Grid>
            <Label Content="First Name:" HorizontalAlignment="Left" Margin="10,64,0,0" VerticalAlignment="Top"/>
            <Label Content="Surname:" HorizontalAlignment="Left" Margin="10,95,0,0" VerticalAlignment="Top"/>
            <Label Content="Email:" HorizontalAlignment="Left" Margin="10,126,0,0" VerticalAlignment="Top"/>
            <Label Content="Phone:" HorizontalAlignment="Left" Margin="10,157,0,0" VerticalAlignment="Top"/>
            <Label Content="Address Line 1:" HorizontalAlignment="Left" Margin="10,188,0,0" VerticalAlignment="Top"/>
            <Label Content="Address Line 2:" HorizontalAlignment="Left" Margin="10,219,0,0" VerticalAlignment="Top"/>
            <Label Content="City:" HorizontalAlignment="Left" Margin="10,250,0,0" VerticalAlignment="Top"/>
            <Label Content="County:" HorizontalAlignment="Left" Margin="10,281,0,0" VerticalAlignment="Top"/>
            <Label Content="Account Type:" HorizontalAlignment="Left" Margin="10,312,0,0" VerticalAlignment="Top"/>
            <Label Content="Account Number:" HorizontalAlignment="Left" Margin="345,64,0,0" VerticalAlignment="Top"/>
            <Label Content="Sort Code:" HorizontalAlignment="Left" Margin="345,95,0,0" VerticalAlignment="Top"/>
            <Label Content="Overdraft Limit:" HorizontalAlignment="Left" Margin="345,126,0,0" VerticalAlignment="Top"/>
            <TextBox x:Name="txtFirstname" HorizontalAlignment="Left" Margin="105,68,0,0" TextWrapping="Wrap" Text="TextBlock" VerticalAlignment="Top" RenderTransformOrigin="0.192,0.428" Width="193"/>
            <ComboBox x:Name="cboCounty" HorizontalAlignment="Left" Margin="105,283,0,0" VerticalAlignment="Top" Width="193"/>
            <RadioButton x:Name="rdoCurrent" Content="Current" HorizontalAlignment="Left" Margin="105,318,0,0" VerticalAlignment="Top" IsChecked="True"/>
            <RadioButton x:Name="rdoSavings" Content="Savings" HorizontalAlignment="Left" Margin="213,318,0,0" VerticalAlignment="Top"/>
            <TextBox x:Name="txtSurname" HorizontalAlignment="Left" Margin="105,99,0,0" TextWrapping="Wrap" Text="TextBlock" VerticalAlignment="Top" RenderTransformOrigin="0.192,0.428" Width="193"/>
            <TextBox x:Name="txtEmail" HorizontalAlignment="Left" Margin="105,130,0,0" TextWrapping="Wrap" Text="TextBlock" VerticalAlignment="Top" RenderTransformOrigin="0.192,0.428" Width="193"/>
            <TextBox x:Name="txtPhone" HorizontalAlignment="Left" Margin="105,161,0,0" TextWrapping="Wrap" Text="TextBlock" VerticalAlignment="Top" RenderTransformOrigin="0.192,0.428" Width="193"/>
            <TextBox x:Name="txtAddress1" HorizontalAlignment="Left" Margin="105,192,0,0" TextWrapping="Wrap" Text="TextBlock" VerticalAlignment="Top" RenderTransformOrigin="0.192,0.428" Width="193"/>
            <TextBox x:Name="txtAddress2" HorizontalAlignment="Left" Margin="105,223,0,0" TextWrapping="Wrap" Text="TextBlock" VerticalAlignment="Top" RenderTransformOrigin="0.192,0.428" Width="193"/>
            <TextBox x:Name="txtCity" HorizontalAlignment="Left" Margin="105,254,0,0" TextWrapping="Wrap" Text="TextBlock" VerticalAlignment="Top" RenderTransformOrigin="0.192,0.428" Width="193"/>
            <TextBox x:Name="txtAccountNum" HorizontalAlignment="Left" Margin="453,68,0,0" TextWrapping="Wrap" Text="TextBlock" VerticalAlignment="Top" RenderTransformOrigin="0.192,0.428" Width="193"/>
            <TextBox x:Name="txtSortCode" HorizontalAlignment="Left" Margin="453,99,0,0" TextWrapping="Wrap" Text="TextBlock" VerticalAlignment="Top" RenderTransformOrigin="0.192,0.428" Width="193"/>
            <TextBox x:Name="txtOverdraftLimit" HorizontalAlignment="Left" Margin="453,130,0,0" TextWrapping="Wrap" Text="TextBlock" VerticalAlignment="Top" RenderTransformOrigin="0.192,0.428" Width="193"/>
            <Button x:Name="btnAdd" Content="Add" HorizontalAlignment="Left" Margin="680,64,0,0" VerticalAlignment="Top" Width="110" Height="40" />
            <Button x:Name="btnEdit" Content="Edit" HorizontalAlignment="Left" Margin="680,119,0,0" VerticalAlignment="Top" Width="110" Height="40"/>
            <Button x:Name="btnCancel" Content="Cancel" HorizontalAlignment="Left" Margin="680,174,0,0" VerticalAlignment="Top" Width="110" Height="40" IsCancel="True"/>
            <Button x:Name="btnExport" Content="Export XML" HorizontalAlignment="Left" Margin="680,229,0,0" VerticalAlignment="Top" Width="110" Height="40"/>
            <Button x:Name="btnCLose" Content="Close" HorizontalAlignment="Left" Margin="680,283,0,0" VerticalAlignment="Top" Width="110" Height="40"/>

        </Grid>
    </DockPanel>
</Window>
