<Window x:Class="Assignment_2_master.Main"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Assignment_2_master"
        mc:Ignorable="d"
        Title="Main" Height="450" Width="800">
    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="File">
                <MenuItem Header="Login"></MenuItem>
                <MenuItem Header="Log out"></MenuItem>
                <MenuItem Header="Register"></MenuItem>
                <MenuItem Header="Exit"></MenuItem>
            </MenuItem>
            <MenuItem Header="Account">
                <MenuItem Header="New Account"></MenuItem>
                <MenuItem Header="Edit Account"></MenuItem>
                <MenuItem Header="Deposit Funds"></MenuItem>
                <MenuItem Header="Withdraw Funds"></MenuItem>
                <MenuItem Header="Transfer Funds"></MenuItem>
                <MenuItem Header="View Transactions"></MenuItem>
            </MenuItem>
            <MenuItem Header="View Accounts"></MenuItem>
        </Menu>
        <Grid>
            <Border Background="#FF6B6B6D" Margin="5,5,5,5" CornerRadius="30" >
                <StackPanel Margin="20,20,20,20">
                    <Separator/>
                    <Label x:Name="lblUser" Content="Username" Foreground="#FFF9F4F4" FontSize="18"/>
                    <TextBox x:Name="txtUsername" TextWrapping="Wrap" FontSize="18" />
                    <Label x:Name="lblPass" Content="Password" FontSize="18" Foreground="#FFF7F6F6"/>
                    <TextBox x:Name="txtPassword" FontSize="18" />
                    <Button x:Name="btnLogin" Content="Login" FontSize="18" Margin="20,20,20,0" Background="#FFDDDDDD"/>
                </StackPanel>
            </Border>
        </Grid>
    </DockPanel>
</Window>
