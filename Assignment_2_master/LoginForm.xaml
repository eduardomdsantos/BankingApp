<Window x:Class="Assignment_2_master.LoginForm"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Assignment_2_master"
        mc:Ignorable="d"
        Title="LoginForm" Height="450" Width="800">
    <Grid>
        <TextBox x:Name="txtUsername" TabIndex="0" HorizontalAlignment="Center" Margin="0,148,0,0" TextWrapping="Wrap" Text="Username" VerticalAlignment="Top" Width="264"/>
        <PasswordBox x:Name="txtPassword" TabIndex="1" HorizontalAlignment="Center" Margin="0,199,0,0" VerticalAlignment="Top" Width="264" PasswordChar="*" />
        <Button TabIndex="2" Content="Button" HorizontalAlignment="Center" Margin="0,243,0,0" VerticalAlignment="Top" RenderTransformOrigin="2.387,-0.542" Width="264" Click="Button_Click"/>

    </Grid>
</Window>
