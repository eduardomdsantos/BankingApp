<Window x:Class="Assignment_2_master.View_Accounts"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Assignment_2_master"
        mc:Ignorable="d"
        Title="View Transactions" Height="450" Width="800">
    <DockPanel>
        <Grid>
            <StackPanel>
                <TextBlock Margin="0,10" HorizontalAlignment="Center" FontWeight="Bold" FontSize="16" Text="List of Transactions" />
                <DataGrid x:Name="dgTranscations" AutoGenerateColumns="True" d:ItemsSource="{d:SampleData ItemCount=5}" />
            </StackPanel>

        </Grid>
    </DockPanel>
</Window>
