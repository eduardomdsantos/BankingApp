<Window x:Class="Assignment_2_master.View_Accounts"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Assignment_2_master"
        mc:Ignorable="d"
        Title="View_Accounts" Height="450" Width="800">
    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="File">
                <MenuItem Header="Login"></MenuItem>
                <MenuItem Header="Logout"></MenuItem>
                <MenuItem Header="Register"></MenuItem>
                <MenuItem Header="Exit"></MenuItem>
            </MenuItem>
            <MenuItem Header="Account">
                <MenuItem Header="New Account"></MenuItem>
                <MenuItem Header="Edit Account"></MenuItem>
                <MenuItem Header="Deposit Funds"></MenuItem>
                <MenuItem Header="Withdraw Funds"></MenuItem>
                <MenuItem Header="Transfer Funds"></MenuItem>
                <MenuItem Header="View Transactions"></MenuItem>
            </MenuItem>
            <MenuItem Header="View Accounts"></MenuItem>
        </Menu>
        <Grid>
            <DataGrid d:ItemsSource="{d:SampleData ItemCount=5}"/>

        </Grid>
    </DockPanel>
</Window>
