<Window x:Class="Assignment_2_master.FormTransaction"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Assignment_2_master"
        mc:Ignorable="d"
        Loaded="Window_Loaded"
        Title="FormTransaction" Width="1280" Height="768"
        WindowStartupLocation="CenterScreen">
    <Grid>

        <TextBlock Text="Transaction Type:" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="30,135,0,0"/>

        <ComboBox x:Name="cmbTransactionType" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="164,129,0,0" Width="200" SelectionChanged="cmbTransactionType_SelectionChanged"></ComboBox>


        <Rectangle HorizontalAlignment="Left" Height="91" Margin="18,17,0,0" Stroke="Black" VerticalAlignment="Top" Width="620"/>
        <Label Content="Account ID:" HorizontalAlignment="Left" Margin="33,25,0,0" VerticalAlignment="Top"/>
        <TextBox x:Name="txtFindAccountID" TabIndex="0" HorizontalAlignment="Left" Margin="105,29,0,0" TextWrapping="Wrap" Text="TextBlock" VerticalAlignment="Top" RenderTransformOrigin="0.192,0.428" Width="193"/>
        <Button x:Name="btnFind" Content="Find" HorizontalAlignment="Left" Height="22" Margin="319,25,0,0" VerticalAlignment="Top" Width="81" Click="btnFind_Click"/>

        <Label Content="Amount:" HorizontalAlignment="Left" Margin="30,171,0,0" VerticalAlignment="Top"/>
        <TextBox x:Name="txtAmount" TabIndex="13" HorizontalAlignment="Left" Margin="164,175,0,0" TextWrapping="Wrap" Text="TextBlock" VerticalAlignment="Top" RenderTransformOrigin="0.192,0.428" Width="194"/>

        <StackPanel HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,20,20" Orientation="Horizontal">
            <Button x:Name="btnAdd" Content="Add" Width="100" Margin="5" Click="btnAdd_Click"/>
            <Button x:Name="btnClose" Content="Close" Width="100" Margin="5" Click="btnClose_Click"/>
        </StackPanel>
        <TabControl HorizontalAlignment="Center" Name="tabControl" Height="278" Margin="0,221,0,0" VerticalAlignment="Top" Width="1242">
            <TabItem Header="Internal Transfer" Name="tabInternalTransfer">
                <Grid Background="#FFE5E5E5" Height="241">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="134*"/>
                        <ColumnDefinition Width="47*"/>
                        <ColumnDefinition Width="1055*"/>
                    </Grid.ColumnDefinitions>
                    <Label Content="Destination Account ID:" HorizontalAlignment="Left" Margin="33,25,0,0" VerticalAlignment="Top" Grid.ColumnSpan="2"/>
                    <TextBox x:Name="txtDestinationAccountID" TabIndex="0" HorizontalAlignment="Left" Margin="39,27,0,0" TextWrapping="Wrap" Text="TextBlock" VerticalAlignment="Top" RenderTransformOrigin="0.192,0.428" Width="193" Grid.ColumnSpan="2" Grid.Column="1"/>
                    <Button x:Name="btnFindDestinationAccountID" Content="Find" HorizontalAlignment="Left" Height="22" Margin="191,25,0,0" VerticalAlignment="Top" Width="81" Grid.Column="2" Click="btnFindDestinationAccountID_Click"/>
                    <Label Content="Reference Number:" HorizontalAlignment="Left" Margin="33,99,0,0" VerticalAlignment="Top" Grid.ColumnSpan="2"/>
                    <TextBox x:Name="txtInternalTransferReferenceNumber" TabIndex="0" HorizontalAlignment="Left" Margin="37,98,0,0" TextWrapping="Wrap" Text="TextBlock" VerticalAlignment="Top" RenderTransformOrigin="0.192,0.428" Width="193" Grid.ColumnSpan="2" Grid.Column="1"/>
                    <Label Content="First Name:" HorizontalAlignment="Center" Margin="0,45,0,0" VerticalAlignment="Top"/>
                    <TextBox x:Name="txtDestinationFirstName" HorizontalAlignment="Left" Margin="104,49,0,0" VerticalAlignment="Top" Width="193" IsEnabled="False" Grid.ColumnSpan="3"/>
                    <Label Content="Surname:" HorizontalAlignment="Left" Margin="133,48,0,0" VerticalAlignment="Top" Grid.Column="2"/>
                    <TextBox x:Name="txtDestinationSurname" HorizontalAlignment="Left" Margin="205,52,0,0" VerticalAlignment="Top" Width="193" IsEnabled="False" Grid.Column="2"/>
                    <Label Content="Account:" HorizontalAlignment="Left" Margin="32,68,0,0" VerticalAlignment="Top"/>
                    <TextBox x:Name="txtDestinationAccountNumber" HorizontalAlignment="Left" Margin="104,72,0,0" VerticalAlignment="Top" Width="193" IsEnabled="False" Grid.ColumnSpan="3"/>
                </Grid>
            </TabItem>
            <TabItem Header="External Transfer" Name="tabExternalTransfer">
                <Grid Background="#FFE5E5E5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="65*"/>
                        <ColumnDefinition Width="1171*"/>
                    </Grid.ColumnDefinitions>
                    <Label Content="Recipient Account Number:" HorizontalAlignment="Left" Margin="33,60,0,0" VerticalAlignment="Top" Grid.ColumnSpan="2"/>
                    <TextBox x:Name="txtRecipientAccountNumber" TabIndex="0" HorizontalAlignment="Left" Margin="176,64,0,0" TextWrapping="Wrap" Text="TextBlock" VerticalAlignment="Top" RenderTransformOrigin="0.192,0.428" Width="193" Grid.Column="1"/>

                    <Label Content="Recipient Account Holder Name:" HorizontalAlignment="Left" Margin="33,94,0,0" VerticalAlignment="Top" Grid.ColumnSpan="2"/>
                    <TextBox x:Name="txtRecipientAccountHolderName" TabIndex="0" HorizontalAlignment="Left" Margin="176,98,0,0" TextWrapping="Wrap" Text="TextBlock" VerticalAlignment="Top" RenderTransformOrigin="0.192,0.428" Width="193" Grid.Column="1"/>

                    <Label Content="Intermediary Bank Name:" HorizontalAlignment="Left" Margin="33,124,0,0" VerticalAlignment="Top" Grid.ColumnSpan="2"/>
                    <TextBox x:Name="txtIntermediaryBankName" TabIndex="0" HorizontalAlignment="Left" Margin="176,128,0,0" TextWrapping="Wrap" Text="TextBlock" VerticalAlignment="Top" RenderTransformOrigin="0.192,0.428" Width="193" Grid.Column="1"/>

                    <Label Content="Intermediary Bank Account Number:" HorizontalAlignment="Left" Margin="33,154,0,0" VerticalAlignment="Top" Grid.ColumnSpan="2"/>
                    <TextBox x:Name="txtIntermediaryBankAccountNumber" TabIndex="0" HorizontalAlignment="Left" Margin="176,158,0,0" TextWrapping="Wrap" Text="TextBlock" VerticalAlignment="Top" RenderTransformOrigin="0.192,0.428" Width="193" Grid.Column="1" Height="22"/>
                    <Label Content="Reference Number:" HorizontalAlignment="Left" Margin="33,10,0,0" VerticalAlignment="Top" Grid.ColumnSpan="2"/>
                    <TextBox x:Name="txtExternalTransferReferenceNumber" TabIndex="0" HorizontalAlignment="Left" Margin="176,10,0,0" TextWrapping="Wrap" Text="TextBlock" VerticalAlignment="Top" RenderTransformOrigin="0.192,0.428" Width="193" Grid.Column="1"/>
                    <Label Content="Recipient Bank Name :" HorizontalAlignment="Left" Margin="33,37,0,0" VerticalAlignment="Top" Grid.ColumnSpan="2"/>
                    <TextBox x:Name="txtRecipientBankName" TabIndex="0" HorizontalAlignment="Left" Margin="176,41,0,0" TextWrapping="Wrap" Text="TextBlock" VerticalAlignment="Top" RenderTransformOrigin="0.192,0.428" Width="193" Grid.Column="1"/>

                </Grid>
            </TabItem>
        </TabControl>
        <Label Content="First Name:" HorizontalAlignment="Left" Margin="32,45,0,0" VerticalAlignment="Top"/>
        <TextBox x:Name="txtFirstName" HorizontalAlignment="Left" Margin="104,49,0,0" VerticalAlignment="Top" Width="193" IsEnabled="False"/>

        <Label Content="Surname:" HorizontalAlignment="Left" Margin="314,48,0,0" VerticalAlignment="Top"/>
        <TextBox x:Name="txtSurname" HorizontalAlignment="Left" Margin="386,52,0,0" VerticalAlignment="Top" Width="193" IsEnabled="False"/>

        <Label Content="Account:" HorizontalAlignment="Left" Margin="32,68,0,0" VerticalAlignment="Top"/>
        <TextBox x:Name="txtAccountNumber" HorizontalAlignment="Left" Margin="104,72,0,0" VerticalAlignment="Top" Width="193" IsEnabled="False"/>

        <Label Content="Balance:" HorizontalAlignment="Left" Margin="314,71,0,0" VerticalAlignment="Top"/>
        <TextBox x:Name="txtBalance" HorizontalAlignment="Left" Margin="386,75,0,0" VerticalAlignment="Top" Width="193" IsEnabled="False"/>


    </Grid>
</Window>
